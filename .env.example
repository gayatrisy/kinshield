# Nebius Token Factory (https://tokenfactory.nebius.com) — never commit the real key
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# NVIDIA Nemotron model IDs. Confirm with: python scripts/check_live.py
KS_MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
KS_MODEL_MAIN=nvidia/nemotron-3-super-120b-a12b
KS_MODEL_DEEP=nvidia/Nemotron-3-Ultra-550b-a55b
KS_MODEL_VISION=nvidia/Nemotron-3.5-Super-VL

# Telegram bot from @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Chat or channel that receives alerts from demo workspaces whose caregiver hasn't linked their own chat
TELEGRAM_DEMO_CHAT_ID=

# App
KINSHIELD_PUBLIC_URL=http://localhost:8000
KINSHIELD_SECRET=change-me-to-a-long-random-string
KINSHIELD_DEMO_MODE=1
KINSHIELD_WORKSPACE_TTL_DAYS=7
KINSHIELD_MODEL_CALLS_PER_HOUR=60
KINSHIELD_ALLOW_VISION=1
